<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="580.0" prefWidth="520.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="InboxController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 12 15 12 15; -fx-background-color: #2c3e50;">
            <Button fx:id="backBtn"
                    text="← Back"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
            <Label text="Messages"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- CONVERSATION LIST -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="conversationsContainer" spacing="0" />
        </ScrollPane>
    </center>

</BorderPane>
