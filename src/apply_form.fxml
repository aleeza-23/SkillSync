<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="380.0" prefWidth="500.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ApplyFormController">
    <children>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="4.0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="25.0">
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2f3640;" text="SkillSync" />
            <Label fx:id="jobTitleLabel"
                   style="-fx-font-size: 16px; -fx-text-fill: #636e72;"
                   text="Apply for Job" />
        </VBox>

        <!-- Form -->
        <GridPane alignment="CENTER" hgap="15" vgap="14"
                  AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="105">
            <padding>
                <Insets bottom="20" left="15" right="15" top="15" />
            </padding>

            <columnConstraints>
                <ColumnConstraints minWidth="110" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label style="-fx-font-weight: bold;" text="Cover Letter:"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"
                   GridPane.valignment="TOP" />
            <TextArea fx:id="coverLetterField"
                      promptText="Explain why you're the best fit for this job. Mention your relevant skills and experience..."
                      wrapText="true" prefRowCount="7"
                      GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label fx:id="messageLabel"
                   style="-fx-font-size: 12px;"
                   GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1"
                   GridPane.halignment="CENTER" />

            <Button text="Submit Application"
                    onAction="#handleSubmit"
                    style="-fx-background-color: #273c75; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18 8 18; -fx-background-radius: 6;"
                    GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2"
                    GridPane.halignment="CENTER" />

            <rowConstraints>
                <RowConstraints />
                <RowConstraints minHeight="20" />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

    </children>
</AnchorPane>
