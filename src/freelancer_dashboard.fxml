<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: #f5f6fa;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="freelancerController">

    <!-- TOP BAR -->
    <HBox layoutX="0" layoutY="0"
          prefWidth="600"
          prefHeight="60"
          spacing="15"
          style="-fx-background-color: #2c3e50; -fx-padding: 10;">

        <Label fx:id="topUsernameLabel"
               text="User"
               style="-fx-text-fill: white; -fx-font-size: 19px;" />

        <Region HBox.hgrow="ALWAYS" />

        <ImageView fx:id="topProfileImageView" fitWidth="36" fitHeight="36" preserveRatio="true" />

        <Button fx:id="logoutBtn"
                text="Logout"
                onAction="#handleLogout"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <!-- Welcome Text -->
    <Label fx:id="welcomeLabel"
           layoutX="20"
           layoutY="90"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2f3640;"
           text="What do you want to do today?" />

    <!-- Subtitle -->
    <Label fx:id="subtitleLabel"
           layoutX="20"
           layoutY="120"
           style="-fx-font-size: 13px; -fx-text-fill: #636e72;"
           text="Freelancer Dashboard" />

    <!-- Main Action Buttons -->
    <VBox spacing="18"
          alignment="CENTER"
          AnchorPane.topAnchor="60"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <Button fx:id="browseJobsBtn"
                text="Browse Available Jobs"
                onAction="#handleBrowseJobs"
                prefWidth="260"
                style="-fx-background-color: #273c75; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8;" />

        <Button fx:id="myApplicationsBtn"
                text="My Applications"
                onAction="#handleMyApplications"
                prefWidth="260"
                style="-fx-background-color: #273c75; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8;" />

        <Button fx:id="editProfileBtn"
                text="Edit Profile"
                onAction="#handleEditProfile"
                prefWidth="260"
                style="-fx-background-color: #636e72; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8;" />

        <Button fx:id="messagesBtn"
                text="Messages"
                onAction="#handleMessages"
                prefWidth="260"
                style="-fx-background-color: #636e72; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8;" />

    </VBox>

</AnchorPane>
